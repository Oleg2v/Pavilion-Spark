  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "1.20.16",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
