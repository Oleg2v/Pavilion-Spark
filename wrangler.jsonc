{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Kikkey convention: one Worker per pitch demo, served on <client>.kikkey.com
  "name": "pavilion-spark",
  // Kikkey account (owner of kikkey.com). Pinned: the deploy token can also see another account.
  "account_id": "be9447e281c6e9198712ade2d0241029",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [{ "pattern": "pavilion-spark.kikkey.com", "custom_domain": true }],
  // Unlisted demo: only the custom domain, no *.workers.dev or preview URLs
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "observability": { "enabled": true }
}
